{
  "name": "why",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite --config ui/vite.config.ts",
    "build": "tauri build",
    "build:ui": "tsc -b ui && vite build --config ui/vite.config.ts",
    "test": "pnpm test:rust && pnpm test:ui",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --workspace",
    "test:ui": "vitest run --config ui/vite.config.ts",
    "lint": "pnpm lint:rust && pnpm lint:ui",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --workspace --all-targets -- -D warnings && cargo fmt --manifest-path src-tauri/Cargo.toml --all --check",
    "lint:ui": "eslint . && tsc -b ui",
    "fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all && prettier --write ui eslint.config.js scripts",
    "gen:contracts": "cargo test --manifest-path src-tauri/Cargo.toml -p why --lib contracts::export::regenerate_bindings -- --ignored",
    "tauri": "tauri"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "2.12.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "1.75.0",
    "monaco-editor": "^0.57.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "^4.24.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "4.3.5",
    "@tauri-apps/cli": "2.12.5",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "pnpm": {
    "overrides": {
      "dompurify@<3.4.17": "^3.4.18"
    }
  }
}
