{
  "name": "why-site",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev --port 1591",
    "build": "astro build",
    "preview": "astro preview --port 1591",
    "check": "prettier --check . && astro check",
    "fmt": "prettier --write .",
    "check:version": "node scripts/check-version.mjs",
    "check:size": "node scripts/check-size.mjs",
    "check:copy": "node scripts/check-copy.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:browser": "node scripts/check-browser.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "dependencies": {
    "animejs": "4.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/markdown-remark": "7.3.10",
    "@axe-core/playwright": "4.14.0",
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.13",
    "playwright-core": "1.65.1",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3"
  }
}
