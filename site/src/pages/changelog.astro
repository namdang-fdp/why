---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Base from "../layouts/Base.astro";
import { loadChangelog } from "../data/changelog";
import { links } from "../data/links";
import { release } from "../data/release";

const entries = await loadChangelog();
const slug = (version: string) => `v${version.replaceAll(".", "-")}`;
---

<Base
  title="Changelog · WHY"
  description="Every released change to WHY, rendered from the project's CHANGELOG.md."
>
  <Header />
  <main id="main" class="mx-auto max-w-3xl px-4 pt-16 pb-24 sm:px-6 md:pt-24">
    <div data-enter="0">
      <h1 class="font-display text-5xl leading-tight tracking-tight sm:text-6xl">Changelog</h1>
      <p class="text-muted mt-6 text-lg leading-relaxed">
        What changed in each release of WHY, newest first. This page is rendered from{" "}
        <a href={links.changelog} class="text-accent underline underline-offset-4">
          CHANGELOG.md
        </a>{" "}
        in the repository, which follows{" "}
        <a
          href="https://keepachangelog.com/en/1.1.0/"
          class="text-accent underline underline-offset-4"
        >
          Keep a Changelog
        </a>{" "}
        and Semantic Versioning.
      </p>
    </div>

    <nav aria-label="Versions" class="mt-10">
      <ul class="text-muted flex flex-wrap gap-x-6 gap-y-2 text-sm">
        {entries.map((entry) => (
          <li>
            <a href={`#${slug(entry.version)}`} class="hover:text-ink underline underline-offset-4">
              {entry.version}
              {entry.date && ` · ${entry.date}`}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    {entries.map((entry) => (
      <article
        id={slug(entry.version)}
        aria-labelledby={`${slug(entry.version)}-title`}
        data-reveal
        class="border-line mt-14 border-t pt-10"
      >
        <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
          <h2 id={`${slug(entry.version)}-title`} class="font-display text-4xl tracking-tight">
            {entry.version}
          </h2>
          <p class="text-muted text-sm">
            {entry.date && <time datetime={entry.date}>{entry.date}</time>}
            {entry.date && /^\d/.test(entry.version) && <span aria-hidden="true"> · </span>}
            {/^\d/.test(entry.version) && (
              <a
                href={`${release.repo}/releases/tag/v${entry.version}`}
                class="hover:text-ink underline underline-offset-4"
              >
                Release on GitHub
              </a>
            )}
          </p>
        </div>
        <div class="prose-why mt-6" set:html={entry.html} />
      </article>
    ))}
  </main>
  <Footer />
</Base>
