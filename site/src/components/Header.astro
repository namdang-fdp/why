---
import logo from "../assets/logo.svg";
import { links } from "../data/links";

// Anchors start with "/" so they also work from the other pages.
const nav = [
  ["What it does", "/#today"],
  ["Safety", "/#safety"],
  ["Get it", "/#get"],
  ["About", "/about/"],
  ["Changelog", "/changelog/"],
] as const;
const here = Astro.url.pathname;
---

<a
  href="#main"
  class="bg-ink text-bg sr-only z-30 rounded-lg px-4 py-2 focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
>
  Skip to content
</a>
<header class="border-line/60 bg-bg/85 sticky top-0 z-20 border-b backdrop-blur">
  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href="/" class="flex items-center gap-2.5">
      <img src={logo.src} width="28" height="28" alt="" />
      <span class="font-semibold tracking-wide">WHY</span>
    </a>
    <nav aria-label="Primary" class="hidden md:block">
      <ul class="text-muted flex gap-6 text-sm">
        {nav.map(([label, href]) => (
          <li>
            <a
              href={href}
              aria-current={href === here ? "page" : undefined}
              class="hover:text-ink aria-[current=page]:text-ink transition-colors"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="flex items-center gap-2 sm:gap-3">
      <button
        id="theme-toggle"
        type="button"
        hidden
        aria-label="Switch between light and dark theme"
        class="text-muted hover:text-ink border-line inline-flex size-10 items-center justify-center rounded-xl border transition-colors"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.8"></circle>
          <path d="M12 3.5a8.5 8.5 0 0 1 0 17z" fill="currentColor"></path>
        </svg>
      </button>
      <a href={links.repo} class="text-muted hover:text-ink hidden text-sm lg:inline">
        GitHub
      </a>
      <a
        href={links.latest}
        class="bg-ink text-bg rounded-xl px-4 py-2.5 text-sm transition-opacity hover:opacity-90"
      >
        Download
      </a>
      <!-- Below md the nav becomes a menu that works without JavaScript. -->
      <details class="relative md:hidden">
        <summary class="text-muted hover:text-ink border-line inline-flex h-10 cursor-pointer list-none items-center rounded-xl border px-3 text-sm [&::-webkit-details-marker]:hidden">
          Menu
        </summary>
        <ul class="border-line bg-surface absolute top-12 right-0 z-30 w-48 space-y-1 rounded-2xl border p-2 text-sm">
          {nav.map(([label, href]) => (
            <li>
              <a
                href={href}
                aria-current={href === here ? "page" : undefined}
                class="hover:bg-bg block rounded-xl px-3 py-2"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </details>
    </div>
  </div>
</header>
