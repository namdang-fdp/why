{
  "format": 1,
  "name": "claude-duplicate-lines-oldstart",
  "description": "Five identical `tick()` lines in a row. The context of each Claude hunk (`tick()` lines) fits several places, so only the harness's own `oldStart` says which line changed: e1 rewrites line 4, e2 rewrites line 6. Both new lines read `tock()`, yet each belongs to its own op (rule 1), and the identical twins around them stay base (rule 2).",
  "stage": "replay",
  "harness": "claudeCode",
  "file": "src/loop.py",
  "base": {
    "lines": ["start()", "tick()", "tick()", "tick()", "tick()", "tick()", "stop()"],
    "finalNewline": true
  },
  "ops": [
    {
      "id": "e1",
      "session": "s1",
      "turn": "t1",
      "kind": "update",
      "hunks": [
        {
          "oldStart": 3,
          "lines": [" tick()", "-tick()", "+tock()", " tick()"]
        }
      ],
      "before": "auto",
      "after": "none"
    },
    {
      "id": "e2",
      "session": "s1",
      "turn": "t2",
      "kind": "update",
      "hunks": [
        {
          "oldStart": 5,
          "lines": [" tick()", "-tick()", "+tock()", " stop()"]
        }
      ],
      "before": "auto",
      "after": "none"
    }
  ],
  "final": {
    "lines": ["start()", "tick()", "tick()", "tock()", "tick()", "tock()", "stop()"],
    "finalNewline": true
  },
  "expected": [
    { "line": 1, "origin": "base" },
    { "line": 2, "origin": "base" },
    { "line": 3, "origin": "base" },
    { "line": 4, "origin": { "op": "e1" } },
    { "line": 5, "origin": "base" },
    { "line": 6, "origin": { "op": "e2" } },
    { "line": 7, "origin": "base" }
  ]
}
